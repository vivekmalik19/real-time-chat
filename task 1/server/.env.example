# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Proxy Configuration (Set to true if behind a reverse proxy like Nginx, Cloudflare, etc.)
TRUST_PROXY=false

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/meetflow

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_TEMP_SECRET=your_temp_otp_token_secret_here

# Email OTP Configuration (Configurable SMTP Provider)
# If left empty, OTPs will be securely logged to the server console in development mode
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="MeetFlow Security <noreply@meetflow.com>"

# Geolocation Provider (Optional: URL of reliable IP geolocation service)
# Leave empty to avoid inventing location data
GEOLOCATION_API_URL=
