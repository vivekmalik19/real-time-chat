# MeetFlow Server Environment Configuration Template
# Duplicate this file to server/.env and fill in appropriate values.
# NEVER commit real production credentials or API keys to version control.

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
TRUST_PROXY=false

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/meetflow

# JWT Authentication & Authorization Secrets
JWT_SECRET=replace_with_a_secure_random_64_char_string
JWT_EXPIRES_IN=7d
JWT_TEMP_SECRET=replace_with_a_secure_temporary_otp_secret_key

# Email OTP Configuration (SMTP Provider)
# In development, if credentials are left blank, OTPs log directly to the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="MeetFlow Security <noreply@meetflow.com>"

# Geolocation Lookup (Optional IP Geolocation Provider)
GEOLOCATION_API_URL=

# Razorpay Test Mode Configuration (Official Task & Subscription Testing)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

# Video Download Token Secret (Signed HMAC-SHA256 Delivery)
DOWNLOAD_TOKEN_SECRET=replace_with_secure_download_signing_key

# Multilingual Translation Provider Configuration (Official Task 6)
# Supported options: 'mymemory' (default, free public community tier), 'google', 'deepl'
TRANSLATION_PROVIDER=mymemory
GOOGLE_TRANSLATION_API_KEY=
DEEPL_API_KEY=

# WebRTC Signaling & Network Configuration (Official Task 1)
# Small-group mesh limit: mesh bandwidth scales as O(N) per peer and O(N^2) total
MAX_ROOM_PARTICIPANTS=6
# Optional TURN Server for symmetric NAT traversal (comma-separated if multiple)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
